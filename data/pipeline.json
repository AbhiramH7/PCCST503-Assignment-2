{
 "name": "pipeline",
 "resources": ["FileSystem", "GPU", "CPU", "Network"],
 "global_constraints": {},
 "initial_state": {
  "File.raw_exists": true, "Dataset.loaded": false, "Dataset.clean": false, "Model.trained": false,
  "Model.accuracy": 0.0, "Model.evaluated": false, "Report.published": false, "Temp.cleared": false,
  "Backup.done": false, "Slack.pinged": false
 },
 "goal": ["Model.evaluated == true", "Report.published == true"],
 "capabilities": [
  {"name": "LoadCSV", "type": "FILE", "mechanism": {"format": "csv", "path": "/data/raw.csv"},
   "preconditions": ["File.raw_exists == true"], "outputs": [["dataframe", "DF", "tabular"]],
   "effects": ["Dataset.loaded = true"], "resources": ["FileSystem"],
   "cost": {"time_ms": 800, "resource": 1, "risk": 0.02, "energy": 1}, "reliability": 0.99},
  {"name": "CleanData", "type": "COMPUTATION", "mechanism": {"routine": "dropna+scale"},
   "inputs": [["dataframe", "DF", "tabular", true]], "outputs": [["clean_frame", "DF", "clean"]],
   "preconditions": ["Dataset.loaded == true"], "effects": ["Dataset.clean = true"], "resources": ["CPU"],
   "cost": {"time_ms": 2500, "resource": 2, "risk": 0.03, "energy": 2}, "reliability": 0.98},
  {"name": "TrainModel", "type": "COMPUTATION", "mechanism": {"device": "GPU", "algo": "xgboost"},
   "inputs": [["clean_frame", "DF", "clean", true]], "outputs": [["model", "MODEL", "fitted"]],
   "preconditions": ["Dataset.clean == true"], "effects": ["Model.trained = true", "Model.accuracy = 0.91"], "resources": ["GPU"],
   "cost": {"time_ms": 30000, "money": 1.2, "resource": 5, "risk": 0.05, "energy": 8}, "reliability": 0.97},
  {"name": "TrainModel_CPU", "type": "COMPUTATION", "mechanism": {"device": "CPU", "algo": "logreg"},
   "inputs": [["clean_frame", "DF", "clean", true]], "outputs": [["model", "MODEL", "fitted"]],
   "preconditions": ["Dataset.clean == true"], "effects": ["Model.trained = true", "Model.accuracy = 0.88"], "resources": ["CPU"],
   "cost": {"time_ms": 120000, "money": 0.1, "resource": 3, "risk": 0.03, "energy": 5}, "reliability": 0.99},
  {"name": "EvaluateModel", "type": "COMPUTATION", "mechanism": {"routine": "kfold"},
   "inputs": [["model", "MODEL", "fitted", true]],
   "preconditions": ["Model.trained == true"], "effects": ["Model.evaluated = true"], "resources": ["CPU"],
   "cost": {"time_ms": 4000, "resource": 2, "risk": 0.02, "energy": 2}, "reliability": 0.99},
  {"name": "PublishReport", "type": "API", "mechanism": {"method": "POST", "endpoint": "/reports"},
   "preconditions": ["Model.evaluated == true", "Model.accuracy >= 0.8"], "effects": ["Report.published = true"], "resources": ["Network"],
   "cost": {"time_ms": 600, "money": 0.02, "resource": 1, "risk": 0.05, "energy": 1}, "reliability": 0.98},
  {"name": "SendSlackPing", "type": "MESSAGE", "mechanism": {"channel": "slack"},
   "preconditions": ["Slack.pinged == false"], "effects": ["Slack.pinged = true"], "resources": ["Network"],
   "cost": {"time_ms": 150, "resource": 1, "energy": 0.5}, "reliability": 0.99, "note": "irrelevant"},
  {"name": "DeleteTempFiles", "type": "FILE", "mechanism": {"op": "rm", "path": "/tmp"},
   "preconditions": ["Temp.cleared == false"], "effects": ["Temp.cleared = true"], "resources": ["FileSystem"],
   "cost": {"time_ms": 100, "resource": 1, "energy": 0.2}, "reliability": 0.99, "note": "irrelevant"},
  {"name": "BackupDatabase", "type": "DATABASE", "mechanism": {"operation": "DUMP"},
   "preconditions": ["Backup.done == false"], "effects": ["Backup.done = true"], "resources": ["Network"],
   "cost": {"time_ms": 20000, "resource": 4, "energy": 4}, "reliability": 0.97, "note": "irrelevant"},
  {"name": "DeleteDataset", "type": "FILE", "mechanism": {"op": "rm", "path": "/data"},
   "preconditions": ["Dataset.loaded == true"], "effects": ["Dataset.loaded = false", "Dataset.clean = false"], "resources": ["FileSystem"],
   "cost": {"time_ms": 80, "resource": 1, "risk": 0.2, "energy": 0.2}, "reliability": 0.99, "note": "harmful: destroys prerequisites"}
 ]
}
