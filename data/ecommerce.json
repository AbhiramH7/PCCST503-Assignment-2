{
 "name": "ecommerce",
 "resources": ["Database", "Network", "PaymentGateway", "NotificationService", "Browser"],
 "global_constraints": {"transaction_limit": "Payment.amount <= 5000"},
 "initial_state": {
  "User.authenticated": true, "User.role": "CUSTOMER", "Cart.exists": true, "Cart.item_count": 3,
  "Cart.locked": false, "Order.exists": false, "Payment.status": "NOT_STARTED", "Payment.amount": 250,
  "Inventory.available": true, "Notification.sent": false, "Report.generated": false,
  "Profile.photo_updated": false, "Logs.archived": false, "Cart.discount_applied": false,
  "Data.cart_id": "UUID|uuid"
 },
 "goal": ["Order.exists == true", "Payment.status == SUCCESS", "Notification.sent == true"],
 "capabilities": [
  {"name": "CreateOrder", "type": "API", "mechanism": {"method": "POST", "endpoint": "/orders"},
   "inputs": [["cart_id", "UUID", "uuid", true]], "outputs": [["order_id", "UUID", "uuid"]],
   "preconditions": ["Cart.exists == true", "Cart.item_count > 0", "User.authenticated == true", "Inventory.available == true"],
   "effects": ["Order.exists = true", "Order.status = CREATED", "Cart.locked = true"],
   "resources": ["Database", "Network"], "cost": {"time_ms": 120, "money": 0.0, "resource": 2, "risk": 0.05, "energy": 1},
   "reliability": 0.99, "note": "canonical C1"},
  {"name": "CreateOrder_DB", "type": "DATABASE", "mechanism": {"operation": "INSERT", "table": "orders"},
   "inputs": [["cart_id", "UUID", "uuid", true]], "outputs": [["order_id", "UUID", "uuid"]],
   "preconditions": ["Cart.exists == true", "Cart.item_count > 0", "User.authenticated == true", "Inventory.available == true"],
   "effects": ["Order.exists = true", "Order.status = CREATED", "Cart.locked = true"],
   "resources": ["Database"], "cost": {"time_ms": 40, "money": 0.0, "resource": 1, "risk": 0.25, "energy": 0.5},
   "reliability": 0.95, "note": "bypasses validation: fast but risky"},
  {"name": "CreateOrder_GUI", "type": "GUI", "mechanism": {"action": "CLICK", "component": "submit_button"},
   "inputs": [["cart_id", "UUID", "uuid", true]], "outputs": [["order_id", "UUID", "uuid"]],
   "preconditions": ["Cart.exists == true", "Cart.item_count > 0", "User.authenticated == true", "Inventory.available == true"],
   "effects": ["Order.exists = true", "Order.status = CREATED", "Cart.locked = true"],
   "resources": ["Browser", "Network"], "cost": {"time_ms": 2500, "money": 0.0, "resource": 3, "risk": 0.02, "energy": 3},
   "reliability": 0.90, "note": "slow human-speed UI automation"},
  {"name": "MakePayment", "type": "API", "mechanism": {"method": "POST", "endpoint": "/payments"},
   "inputs": [["order_id", "UUID", "uuid", true]], "outputs": [["payment_id", "UUID", "uuid"]],
   "preconditions": ["Order.exists == true", "Payment.status == NOT_STARTED", "User.authenticated == true"],
   "policies": ["transaction_limit"], "effects": ["Payment.status = SUCCESS"],
   "resources": ["PaymentGateway", "Network"], "cost": {"time_ms": 800, "money": 0.30, "resource": 2, "risk": 0.10, "energy": 1},
   "reliability": 0.97, "note": "canonical C2"},
  {"name": "SendNotification", "type": "EVENT", "mechanism": {"trigger": "PaymentSucceeded", "handler": "SendNotification"},
   "preconditions": ["Payment.status == SUCCESS"], "effects": ["Notification.sent = true"],
   "resources": ["NotificationService"], "cost": {"time_ms": 150, "money": 0.01, "resource": 1, "risk": 0.02, "energy": 0.5},
   "reliability": 0.995, "note": "canonical C3"},
  {"name": "CancelCart", "type": "API", "mechanism": {"method": "DELETE", "endpoint": "/cart"},
   "preconditions": ["Order.exists == false", "Cart.exists == true"], "effects": ["Cart.exists = false", "Cart.item_count = 0"],
   "resources": ["Database", "Network"], "cost": {"time_ms": 60, "resource": 1, "risk": 0.05, "energy": 0.5},
   "reliability": 0.99, "note": "assignment's C3 for compatibility test (needs OrderExists=false)"},
  {"name": "CancelOrder", "type": "API", "mechanism": {"method": "DELETE", "endpoint": "/orders"},
   "preconditions": ["Order.exists == true", "Payment.status != SUCCESS"], "effects": ["Order.exists = false", "Order.status = CANCELLED"],
   "resources": ["Database", "Network"], "cost": {"time_ms": 90, "resource": 1, "risk": 0.10, "energy": 0.5},
   "reliability": 0.98, "note": "harmful: undoes the goal"},
  {"name": "ApplyDiscount", "type": "FUNCTION", "mechanism": {"function": "apply_discount"},
   "preconditions": ["Cart.exists == true"], "effects": ["Cart.discount_applied = true"],
   "cost": {"time_ms": 5, "resource": 0.5, "energy": 0.1}, "reliability": 0.999, "note": "irrelevant to goal"},
  {"name": "AuthenticateUser", "type": "API", "mechanism": {"method": "POST", "endpoint": "/login"},
   "preconditions": ["User.authenticated == false"], "effects": ["User.authenticated = true"],
   "resources": ["Network"], "cost": {"time_ms": 300, "resource": 1, "risk": 0.05, "energy": 0.5},
   "reliability": 0.98, "note": "redundant in this initial state (user already authenticated)"},
  {"name": "GenerateSalesReport", "type": "FILE", "mechanism": {"format": "csv", "path": "/reports"},
   "preconditions": ["Report.generated == false"], "effects": ["Report.generated = true"],
   "resources": ["Database"], "cost": {"time_ms": 4000, "resource": 3, "energy": 2}, "reliability": 0.97, "note": "irrelevant"},
  {"name": "UpdateProfilePhoto", "type": "GUI", "mechanism": {"action": "UPLOAD", "component": "avatar"},
   "preconditions": ["User.authenticated == true"], "effects": ["Profile.photo_updated = true"],
   "resources": ["Browser"], "cost": {"time_ms": 1800, "resource": 1, "energy": 1}, "reliability": 0.95, "note": "irrelevant"},
  {"name": "ArchiveLogs", "type": "COMPUTATION", "mechanism": {"job": "logrotate"},
   "preconditions": ["Logs.archived == false"], "effects": ["Logs.archived = true"],
   "cost": {"time_ms": 9000, "resource": 4, "energy": 3}, "reliability": 0.99, "note": "irrelevant"}
 ]
}
