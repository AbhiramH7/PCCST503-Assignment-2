{
 "name": "travel",
 "resources": ["Network", "PaymentGateway", "MailService", "Browser"],
 "global_constraints": {},
 "initial_state": {
  "User.authenticated": true, "Search.query_set": true, "Flight.options_loaded": false, "Flight.selected": false,
  "Hotel.options_loaded": false, "Hotel.selected": false, "Trip.booked": false, "Trip.status": "NONE",
  "Payment.status": "NOT_STARTED", "Itinerary.emailed": false, "Passport.valid": true, "Budget.remaining": 2000,
  "Weather.checked": false, "Car.rented": false, "Phrasebook.ready": false
 },
 "goal": ["Trip.status == CONFIRMED", "Payment.status == SUCCESS", "Itinerary.emailed == true"],
 "capabilities": [
  {"name": "SearchFlights", "type": "API", "mechanism": {"method": "GET", "endpoint": "/flights"},
   "preconditions": ["Search.query_set == true"], "outputs": [["flight_list", "LIST", "flights"]],
   "effects": ["Flight.options_loaded = true"], "resources": ["Network"],
   "cost": {"time_ms": 700, "money": 0.0, "resource": 1, "risk": 0.02, "energy": 1}, "reliability": 0.98},
  {"name": "SelectFlight", "type": "GUI", "mechanism": {"action": "CLICK", "component": "flight_row"},
   "inputs": [["flight_list", "LIST", "flights", true]], "outputs": [["flight_id", "ID", "flight"]],
   "preconditions": ["Flight.options_loaded == true"], "effects": ["Flight.selected = true"], "resources": ["Browser"],
   "cost": {"time_ms": 1500, "resource": 1, "risk": 0.01, "energy": 1}, "reliability": 0.95},
  {"name": "SearchHotels", "type": "API", "mechanism": {"method": "GET", "endpoint": "/hotels"},
   "preconditions": ["Search.query_set == true"], "outputs": [["hotel_list", "LIST", "hotels"]],
   "effects": ["Hotel.options_loaded = true"], "resources": ["Network"],
   "cost": {"time_ms": 650, "resource": 1, "risk": 0.02, "energy": 1}, "reliability": 0.98},
  {"name": "SelectHotel", "type": "GUI", "mechanism": {"action": "CLICK", "component": "hotel_row"},
   "inputs": [["hotel_list", "LIST", "hotels", true]], "outputs": [["hotel_id", "ID", "hotel"]],
   "preconditions": ["Hotel.options_loaded == true"], "effects": ["Hotel.selected = true"], "resources": ["Browser"],
   "cost": {"time_ms": 1500, "resource": 1, "risk": 0.01, "energy": 1}, "reliability": 0.95},
  {"name": "HoldBooking", "type": "API", "mechanism": {"method": "POST", "endpoint": "/bookings"},
   "inputs": [["flight_id", "ID", "flight", true], ["hotel_id", "ID", "hotel", true]], "outputs": [["booking_id", "UUID", "uuid"]],
   "preconditions": ["Flight.selected == true", "Hotel.selected == true", "Passport.valid == true"],
   "effects": ["Trip.booked = true", "Trip.status = HELD"], "resources": ["Network"],
   "cost": {"time_ms": 900, "money": 0.0, "resource": 2, "risk": 0.08, "energy": 1}, "reliability": 0.97},
  {"name": "PayTrip", "type": "API", "mechanism": {"method": "POST", "endpoint": "/trip-payments"},
   "inputs": [["booking_id", "UUID", "uuid", true]],
   "preconditions": ["Trip.status == HELD", "Payment.status == NOT_STARTED", "Budget.remaining >= 500"],
   "effects": ["Payment.status = SUCCESS", "Trip.status = CONFIRMED"], "resources": ["PaymentGateway", "Network"],
   "cost": {"time_ms": 1100, "money": 0.5, "resource": 2, "risk": 0.12, "energy": 1}, "reliability": 0.96},
  {"name": "EmailItinerary", "type": "MESSAGE", "mechanism": {"channel": "smtp"},
   "inputs": [["booking_id", "UUID", "uuid", true]],
   "preconditions": ["Trip.status == CONFIRMED"], "effects": ["Itinerary.emailed = true"], "resources": ["MailService"],
   "cost": {"time_ms": 200, "money": 0.01, "resource": 1, "risk": 0.02, "energy": 0.5}, "reliability": 0.99},
  {"name": "CheckWeather", "type": "API", "mechanism": {"method": "GET", "endpoint": "/weather"},
   "preconditions": ["Search.query_set == true"], "effects": ["Weather.checked = true"], "resources": ["Network"],
   "cost": {"time_ms": 300, "resource": 1, "energy": 0.5}, "reliability": 0.99, "note": "irrelevant"},
  {"name": "RentCar", "type": "API", "mechanism": {"method": "POST", "endpoint": "/cars"},
   "preconditions": ["Trip.booked == true"], "effects": ["Car.rented = true"], "resources": ["Network"],
   "cost": {"time_ms": 800, "money": 40, "resource": 2, "risk": 0.1, "energy": 1}, "reliability": 0.95, "note": "irrelevant (consumes booking, adds nothing to goal)"},
  {"name": "TranslatePhrases", "type": "FUNCTION", "mechanism": {"function": "translate"},
   "preconditions": ["Phrasebook.ready == false"], "effects": ["Phrasebook.ready = true"],
   "cost": {"time_ms": 50, "resource": 1, "energy": 1}, "reliability": 0.97, "note": "irrelevant"},
  {"name": "CancelTrip", "type": "API", "mechanism": {"method": "DELETE", "endpoint": "/bookings"},
   "preconditions": ["Trip.booked == true"], "effects": ["Trip.booked = false", "Trip.status = CANCELLED"], "resources": ["Network"],
   "cost": {"time_ms": 500, "resource": 1, "risk": 0.1, "energy": 0.5}, "reliability": 0.97, "note": "harmful"}
 ]
}
